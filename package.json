{
  "name": "grid-guess",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "data": "mapshaper -i data/countries.geo.json name=countries -filter-fields name,continent -o format=topojson quantization=1e5 public/countries.topo.json && mapshaper -i data/ne_50m_coastline.geo.json name=coastline -o format=topojson quantization=1e5 public/coastline.topo.json"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "d3": "^7.9.0",
    "geojson-world-map": "^0.0.2",
    "polyclip-ts": "^0.16.8",
    "polygon-clipping": "^0.15.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/d3": "^7.4.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "mapshaper": "^0.6.102",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0"
  }
}
